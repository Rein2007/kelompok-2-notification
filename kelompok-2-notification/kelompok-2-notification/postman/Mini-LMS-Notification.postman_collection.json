{
  "info": {
    "name": "Mini-LMS Kelompok 2 - Notification",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health check (200)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/health"
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"success true\", function () { pm.expect(pm.response.json().success).to.eql(true); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Notifikasi tanpa token (401)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/notifications?user_id=user-001"
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 401\", function () { pm.response.to.have.status(401); });",
              "pm.test(\"Format error sesuai kontrak\", function () { const j = pm.response.json(); pm.expect(j.success).to.eql(false); pm.expect(j.error).to.have.property(\"code\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Buat notifikasi (201)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/notifications"
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"user_id\":\"user-001\",\"message\":\"Submission berhasil diterima\",\"type\":\"submission\",\"submission_id\":\"sub-001\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 201\", function () { pm.response.to.have.status(201); });",
              "pm.test(\"success true\", function () { pm.expect(pm.response.json().success).to.eql(true); });",
              "pm.environment.set(\"notif_id\", pm.response.json().data.id);"
            ]
          }
        }
      ]
    },
