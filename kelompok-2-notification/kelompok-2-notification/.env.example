# Salin menjadi .env lalu sesuaikan (jangan commit .env asli)
# Alamat Auth diambil dari services.json. Variabel di bawah opsional.

# true = lewati validasi token (HANYA untuk uji mandiri tahap 3, matikan saat integrasi)
AUTH_BYPASS=false

# Endpoint validasi token milik Authentication (sepakati dengan Kelompok 1)
AUTH_VALIDATE_METHOD=GET
AUTH_VALIDATE_PATH=/api/auth/me

# Batas waktu menunggu service Auth (detik)
AUTH_TIMEOUT=3
